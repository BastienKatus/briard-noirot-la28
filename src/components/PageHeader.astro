---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';

interface Props {
	eyebrow: string;
	title: string;
	lead?: string;
	image: string;
}

const { eyebrow, title, lead, image } = Astro.props;
---

<section class="page-header container">
	<Image class="bg" src={photo(image)} alt="" widths={[800, 1400]} sizes="100vw" loading="eager" />
	<div class="panel glass-dark">
		<p class="eyebrow">{eyebrow}</p>
		<h1>{title}</h1>
		{lead && <p class="lead">{lead}</p>}
	</div>
</section>

<style>
	.page-header {
		position: relative;
		display: grid;
		align-items: end;
		min-height: clamp(320px, 42vw, 440px);
		margin-top: 20px;
		padding: clamp(16px, 3vw, 32px);
		overflow: hidden;
		border-radius: var(--radius-xl);
		isolation: isolate;
	}

	.page-header :global(.bg) {
		position: absolute;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.page-header::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, rgb(10 20 56 / 0.05), rgb(10 20 56 / 0.55));
	}

	.panel {
		max-width: 640px;
		padding: clamp(20px, 3vw, 32px);
	}

	.eyebrow {
		color: var(--white);
	}

	h1 {
		color: var(--white);
		font-size: clamp(2.2rem, 5vw, 3.4rem);
	}

	.lead {
		margin: 12px 0 0;
		color: rgb(255 255 255 / 0.88);
	}
</style>
