---
import { site } from '../data/site';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(/\/?$/, '/');
const links = site.nav.map((item) => {
	const href = url(item.href);
	return { ...item, href, active: href === current };
});
---

<header class="site-header">
	<div class="bar glass">
		<a class="brand" href={url('/')} aria-label={`${site.name} — accueil`}>
			<span class="flag" aria-hidden="true"></span>
			<span class="brand-name">{site.shortName}</span>
			<span class="brand-tag">LA 28</span>
		</a>

		<nav class="nav-desktop" aria-label="Navigation principale">
			{
				links.map((link) => (
					<a href={link.href} class:list={['nav-link', { active: link.active }]} aria-current={link.active ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="actions">
			<a class="btn btn-primary donate" href={url('/#soutenir')}>Faire un don</a>
			<button class="menu-toggle" popovertarget="nav-mobile" aria-label="Ouvrir le menu">
				<span></span><span></span><span></span>
			</button>
		</div>
	</div>

	<nav id="nav-mobile" class="nav-mobile glass" popover aria-label="Navigation mobile">
		{
			links.map((link) => (
				<a href={link.href} class:list={['nav-link', { active: link.active }]} aria-current={link.active ? 'page' : undefined}>
					{link.label}
				</a>
			))
		}
		<a class="btn btn-primary" href={url('/#soutenir')}>Faire un don</a>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 12px;
		z-index: 50;
		width: min(100% - 2 * var(--gutter), var(--max));
		margin: 12px auto 0;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 8px 8px 8px 20px;
		border-radius: 999px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--navy-950);
		font-weight: 800;
		text-decoration: none;
		white-space: nowrap;
	}

	.flag {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: linear-gradient(90deg, var(--blue) 0 33.3%, var(--white) 33.3% 66.6%, var(--red) 66.6%);
		box-shadow: inset 0 0 0 1px rgb(16 32 90 / 0.15);
	}

	.brand-tag {
		padding: 2px 8px;
		border-radius: 999px;
		background: var(--navy-900);
		color: var(--white);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
	}

	.nav-desktop {
		display: flex;
		gap: 4px;
	}

	.nav-link {
		padding: 9px 16px;
		border-radius: 999px;
		color: var(--ink);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	.nav-link:hover {
		background: rgb(255 255 255 / 0.7);
	}

	.nav-link.active {
		background: var(--navy-900);
		color: var(--white);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.donate {
		padding: 10px 20px;
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		width: 44px;
		height: 44px;
		padding: 0 12px;
		border: 0;
		border-radius: 50%;
		background: var(--navy-900);
		cursor: pointer;
	}

	.menu-toggle span {
		height: 2px;
		border-radius: 2px;
		background: var(--white);
	}

	.nav-mobile {
		inset: 84px var(--gutter) auto;
		width: auto;
		margin: 0;
		padding: 12px;
		border-radius: var(--radius-lg);
		background: rgb(255 255 255 / 0.92);
		color: var(--ink);
	}

	.nav-mobile:popover-open {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.nav-mobile .btn {
		margin-top: 8px;
	}

	.nav-mobile::backdrop {
		background: rgb(10 20 56 / 0.4);
		backdrop-filter: blur(4px);
	}

	@media (max-width: 900px) {
		.nav-desktop,
		.donate {
			display: none;
		}

		.menu-toggle {
			display: flex;
		}
	}
</style>
