---
import { site } from '../data/site';

const { platformName, platformUrl, projectSlug, goal, initialRaised } = site.donation;
const projectUrl = projectSlug ? new URL(`project/${projectSlug}`, platformUrl).href : '';
const donateUrl = projectSlug ? `${projectUrl}/donate` : platformUrl;
const euro = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const percent = goal ? Math.round((initialRaised / goal) * 100) : 0;
const live = Boolean(projectSlug) || initialRaised > 0;
---

<div
	class="donation glass"
	data-donation
	data-endpoint={projectSlug ? `${projectUrl}.json` : undefined}
	data-goal={goal}
	style={`--p: ${Math.min(percent, 100)}`}
>
	<div class="top">
		<p class="status">
			<span class="dot" aria-hidden="true"></span>
			{live ? 'Collecte en cours' : 'Collecte bientôt en ligne'}
		</p>
		<p class="amount">
			<strong data-raised>{euro.format(initialRaised)}</strong>
			<span>collectés sur <span data-goal-label>{euro.format(goal)}</span></span>
		</p>
	</div>

	<div
		class="water"
		role="progressbar"
		aria-label="Progression de la collecte"
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow={Math.min(percent, 100)}
		data-track
	>
		<svg class="boat" viewBox="0 0 72 40" aria-hidden="true">
			<path class="oar" d="M27.5 19 9 35" />
			<path class="blade" d="M9.5 34.5 4.5 38.5" />
			<path class="hull" d="M2 29c18 6 48 6 68-2l-1.5-1.5c-18.5 5.5-46.5 5.5-64.5 2Z" />
			<path class="deck" d="M10 29.4c16 2.9 38 2.9 52-.8" />
			<path class="legs" d="M38 26 31 21.5 25 26" />
			<path class="arm" d="M35 16 27.5 19" />
			<path class="torso" d="M38 26 35 15" />
			<circle class="head" cx="33.6" cy="10.4" r="3.8" />
		</svg>
		<div class="track">
			<div class="fill"></div>
		</div>
	</div>

	<div class="meta">
		<span data-percent>{percent} %</span>
		<span data-donors></span>
	</div>

	<a class="btn btn-primary" href={donateUrl} target="_blank" rel="noopener">
		{projectSlug ? 'Faire un don' : `Découvrir ${platformName}`}
	</a>
	<p class="note">
		Paiement sécurisé sur {platformName}, la plateforme de la Fondation du Sport Français, qui vous envoie le reçu
		fiscal par e-mail : un don de 100 € vous revient à 34 € après réduction d’impôt.
	</p>
</div>

<script>
	const euro = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

	// Endpoint non documenté de la plateforme (iRaiser) : en cas d'échec ou de changement de format,
	// la jauge garde son état initial et le bouton de don reste utilisable.
	for (const box of document.querySelectorAll<HTMLElement>('[data-donation][data-endpoint]')) {
		fetch(box.dataset.endpoint!)
			.then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
			.then(({ project }) => {
				const raised = Number(project.total_amount);
				const goal = Number(project.target_amount) || Number(box.dataset.goal);
				if (!Number.isFinite(raised) || !goal) return;

				const percent = Math.round((raised / goal) * 100);
				box.querySelector('[data-raised]')!.textContent = euro.format(raised);
				box.querySelector('[data-goal-label]')!.textContent = euro.format(goal);
				box.querySelector('[data-percent]')!.textContent = `${percent} %`;
				box.style.setProperty('--p', String(Math.min(percent, 100)));
				box.querySelector('[data-track]')!.setAttribute('aria-valuenow', String(Math.min(percent, 100)));
				const donors = Number(project.total_donations);
				if (donors) box.querySelector('[data-donors]')!.textContent = `${donors} don${donors > 1 ? 's' : ''}`;
			})
			.catch(() => {});
	}
</script>

<style>
	/* Enregistrée pour être animable : sans @property, la jauge et le bateau sautent à leur position sans transition. */
	@property --p {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	@keyframes launch {
		from {
			--p: 0;
		}
	}

	@keyframes bob {
		0%,
		100% {
			transform: translateY(0) rotate(0deg);
		}

		50% {
			transform: translateY(-1.5px) rotate(-2deg);
		}
	}

	.donation {
		display: grid;
		gap: 16px;
		padding: clamp(24px, 4vw, 36px);
		border-radius: var(--radius-xl);
		animation: launch 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s backwards;
		transition: --p 1.2s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.top {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 8px 24px;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--red);
		box-shadow: 0 0 0 4px rgb(239 65 53 / 0.18);
	}

	.amount {
		margin: 0;
		color: var(--ink-soft);
	}

	.amount strong {
		margin-right: 6px;
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		font-weight: 800;
		color: var(--navy-950);
	}

	.water {
		position: relative;
		padding-top: 28px;
	}

	/* Le bateau parcourt la largeur moins la sienne : à 100 % il finit au bout de la jauge sans déborder. */
	.boat {
		position: absolute;
		top: 0;
		left: calc((100% - 64px) * var(--p) / 100);
		width: 64px;
		height: 36px;
		overflow: visible;
		animation: bob 2.6s ease-in-out infinite;
	}

	.hull {
		fill: var(--navy-900);
	}

	.oar,
	.blade,
	.deck,
	.legs,
	.arm,
	.torso {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.oar {
		stroke: var(--navy-900);
		stroke-width: 2;
	}

	.blade {
		stroke: var(--blue);
		stroke-width: 5;
	}

	.deck {
		stroke: rgb(255 255 255 / 0.55);
		stroke-width: 0.9;
	}

	.legs {
		stroke: var(--navy-950);
		stroke-width: 3.6;
	}

	.arm {
		stroke: var(--navy-950);
		stroke-width: 2.8;
	}

	.torso {
		stroke: var(--red);
		stroke-width: 5.5;
	}

	.head {
		fill: var(--navy-950);
	}

	.track {
		height: 14px;
		overflow: hidden;
		border-radius: 999px;
		background: rgb(16 32 90 / 0.08);
		box-shadow: inset 0 1px 2px rgb(16 32 90 / 0.12);
	}

	.fill {
		width: calc(var(--p) * 1%);
		height: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, var(--blue), var(--navy-900) 60%, var(--red));
	}

	.meta {
		display: flex;
		justify-content: space-between;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--navy-900);
	}

	.btn {
		justify-self: start;
	}

	.note {
		margin: 0;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}
</style>
