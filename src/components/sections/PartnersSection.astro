---
import { Image } from 'astro:assets';
import { partners } from '../../data/accueil';
import { site } from '../../data/site';
import { photo } from '../../lib/photos';
---

<section id="partenaires" class="section partners">
	<div class="container">
		<p class="eyebrow">{partners.eyebrow}</p>
		<h2>{partners.title}</h2>
		<ul class="list">
			{
				site.supporters.map((partner) => (
					<li>
						<a class="card glass" href={partner.url} target="_blank" rel="noopener">
							{partner.logo && <Image class="logo" src={photo(partner.logo)} alt="" widths={[240, 480]} sizes="240px" />}
							<span class:list={['name', { solo: !partner.logo }]}>{partner.name}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.partners {
		padding-top: 0;
	}

	.list {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		margin: 28px 0 0;
		padding: 0;
		list-style: none;
	}

	.card {
		display: grid;
		gap: 14px;
		place-items: center;
		align-content: center;
		height: 100%;
		min-height: 168px;
		padding: 24px;
		border-radius: var(--radius-md);
		text-align: center;
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.card:hover {
		transform: translateY(-2px);
	}

	/* multiply efface le fond blanc opaque du logo Swift Racing (JPG) sur le verre clair des cartes. */
	.list :global(.logo) {
		width: auto;
		max-width: 80%;
		height: auto;
		max-height: 104px;
		mix-blend-mode: multiply;
	}

	.name {
		color: var(--ink-soft);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.solo {
		color: var(--navy-950);
		font-size: 1.1rem;
		font-weight: 800;
	}

	@media (max-width: 960px) {
		.list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 720px) {
		.list {
			grid-template-columns: 1fr;
		}
	}
</style>
