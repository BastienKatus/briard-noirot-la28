---
import { Image } from 'astro:assets';
import { project } from '../../data/accueil';
import { photo } from '../../lib/photos';
---

<section id="projet" class="section project">
	<div class="container">
		<div class="intro">
			<div class="media">
				<Image src={photo(project.photo)} alt={project.photoAlt} widths={[600, 1000, 1400]} sizes="(max-width: 860px) 100vw, 560px" />
				<span class="badge glass-dark">LA 2028 · BRS</span>
			</div>
			<div>
				<p class="eyebrow">{project.eyebrow}</p>
				<h2>{project.title}</h2>
				{project.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
			</div>
		</div>

		<div class="race glass">
			<svg class="race-map" viewBox="0 0 360 400" role="img" aria-label="Schéma du parcours d’une course, détaillé dans la liste">
				<defs>
					<marker id="race-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
						<path d="M0 0 10 5 0 10Z" class="arrow" />
					</marker>
				</defs>
				<rect class="sea" width="360" height="300" />
				<rect class="sand" y="300" width="360" height="100" />
				<path class="shore" d="M0 300c30-8 60 8 90 0s60 8 90 0 60 8 90 0 60 8 90 0" />
				<text class="zone" x="344" y="28" text-anchor="end">Mer</text>
				<text class="zone" x="344" y="328" text-anchor="end">Plage</text>

				<path class="line" d="M70 372h80M190 372h80" />
				<text class="label" x="110" y="392" text-anchor="middle">Départ</text>
				<text class="label" x="230" y="392" text-anchor="middle">Arrivée</text>

				<path class="run" d="M110 368V306" marker-end="url(#race-arrow)" />
				<path
					class="row"
					d="M110 296c0-16 30-36 30-56s-60-30-60-50 60-30 60-50c0-40 20-70 40-90 15-15 50-10 50 25v215"
					marker-end="url(#race-arrow)"
				/>
				<path class="run" d="M230 306v62" marker-end="url(#race-arrow)" />

				<circle class="buoy" cx="110" cy="240" r="7" />
				<circle class="buoy" cx="110" cy="190" r="7" />
				<circle class="buoy" cx="110" cy="140" r="7" />
				<circle class="buoy" cx="203" cy="62" r="9" />

				{
					[
						[78, 336],
						[78, 284],
						[48, 190],
						[264, 52],
						[262, 336],
					].map(([x, y], i) => (
						<g class="step">
							<circle cx={x} cy={y} r="12" />
							<text x={x} y={y + 4.5} text-anchor="middle">
								{i + 1}
							</text>
						</g>
					))
				}
			</svg>
			<div>
				<h3>{project.race.title}</h3>
				<ol class="race-steps">
					{
						project.race.steps.map((step, i) => (
							<li>
								<span class="num">{i + 1}</span>
								{step}
							</li>
						))
					}
				</ol>
			</div>
		</div>

		<ol class="timeline">
			{
				project.timeline.map((step) => (
					<li class="glass">
						<span class="when">{step.when}</span>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))
			}
		</ol>

		<h3 class="needs-title">Ce que financent vos dons</h3>
		<ul class="needs">
			{
				project.needs.map((need) => (
					<li class="glass">
						<h4>{need.title}</h4>
						<p>{need.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.project {
		background: linear-gradient(180deg, transparent, rgb(0 85 164 / 0.06) 20%, rgb(0 85 164 / 0.06) 80%, transparent);
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(28px, 5vw, 64px);
		align-items: center;
	}

	.media {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow);
	}

	.media :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.badge {
		position: absolute;
		top: 16px;
		left: 16px;
		padding: 8px 16px;
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 700;
	}

	.lead {
		margin-top: 16px;
	}

	.race {
		display: grid;
		grid-template-columns: minmax(0, 360px) 1fr;
		gap: clamp(24px, 5vw, 56px);
		align-items: center;
		margin-top: 56px;
		padding: clamp(20px, 3vw, 32px);
		border-radius: var(--radius-xl);
	}

	.race-map {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
	}

	.sea {
		fill: var(--blue-100);
	}

	.sand {
		fill: #f2e4c4;
	}

	.shore {
		fill: none;
		stroke: var(--white);
		stroke-width: 3;
	}

	.zone {
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		fill: var(--ink-soft);
	}

	.line {
		stroke: var(--navy-950);
		stroke-width: 3;
		stroke-dasharray: 6 4;
	}

	.label {
		font-size: 13px;
		font-weight: 700;
		fill: var(--navy-950);
	}

	.row,
	.run {
		fill: none;
		stroke-width: 3;
		stroke-linecap: round;
	}

	.row {
		stroke: var(--navy-900);
	}

	.run {
		stroke: var(--red);
		stroke-dasharray: 1 7;
	}

	.arrow {
		fill: var(--navy-900);
	}

	.buoy {
		fill: #f59e0b;
		stroke: var(--white);
		stroke-width: 2;
	}

	.step circle {
		fill: var(--navy-900);
	}

	.step text {
		font-size: 13px;
		font-weight: 800;
		fill: var(--white);
	}

	.race-steps {
		display: grid;
		gap: 12px;
		margin: 20px 0 0;
		padding: 0;
		list-style: none;
		color: var(--ink-soft);
	}

	.race-steps li {
		display: flex;
		gap: 12px;
		align-items: center;
	}

	.num {
		display: grid;
		flex: none;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--navy-900);
		color: var(--white);
		font-size: 0.85rem;
		font-weight: 800;
	}

	.timeline {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin: 56px 0 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}

	.timeline li {
		position: relative;
		padding: 24px;
		border-radius: var(--radius-lg);
	}

	.timeline li:last-child {
		background: linear-gradient(135deg, var(--navy-900), var(--navy-950));
		border-color: transparent;
		color: var(--white);
	}

	.timeline li:last-child h3,
	.timeline li:last-child .when {
		color: var(--white);
	}

	.timeline li:last-child p {
		color: rgb(255 255 255 / 0.8);
	}

	.when {
		display: inline-block;
		margin-bottom: 8px;
		font-size: 0.85rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: var(--red);
	}

	.timeline p {
		margin: 6px 0 0;
		color: var(--ink-soft);
		font-size: 0.95rem;
	}

	.needs-title {
		margin: 56px 0 16px;
	}

	.needs {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.needs li {
		padding: 20px 22px;
		border-radius: var(--radius-md);
	}

	.needs h4 {
		margin: 0 0 4px;
		font-size: 1rem;
		color: var(--navy-950);
	}

	.needs h4::before {
		content: '';
		display: block;
		width: 24px;
		height: 4px;
		margin-bottom: 12px;
		border-radius: 4px;
		background: var(--red);
	}

	.needs p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.92rem;
	}

	@media (max-width: 960px) {
		.needs {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 860px) {
		.intro,
		.race,
		.timeline {
			grid-template-columns: 1fr;
		}

		.race-map {
			max-width: 360px;
			justify-self: center;
		}
	}

	@media (max-width: 520px) {
		.needs {
			grid-template-columns: 1fr;
		}
	}
</style>
