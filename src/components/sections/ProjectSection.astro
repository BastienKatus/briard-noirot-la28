---
import { Image } from 'astro:assets';
import { project } from '../../data/accueil';
import { photo } from '../../lib/photos';
---

<section id="projet" class="section project">
	<div class="container">
		<div class="intro">
			<div class="media">
				<Image src={photo(project.photo)} alt={project.photoAlt} widths={[600, 1000, 1400]} sizes="(max-width: 860px) 100vw, 560px" />
				<span class="badge glass-dark">LA 2028 · Beach sprint</span>
			</div>
			<div>
				<p class="eyebrow">{project.eyebrow}</p>
				<h2>{project.title}</h2>
				{project.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
			</div>
		</div>

		<ol class="timeline">
			{
				project.timeline.map((step) => (
					<li class="glass">
						<span class="when">{step.when}</span>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))
			}
		</ol>

		<h3 class="needs-title">Ce que financent vos dons</h3>
		<ul class="needs">
			{
				project.needs.map((need) => (
					<li class="glass">
						<h4>{need.title}</h4>
						<p>{need.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.project {
		background: linear-gradient(180deg, transparent, rgb(0 85 164 / 0.06) 20%, rgb(0 85 164 / 0.06) 80%, transparent);
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(28px, 5vw, 64px);
		align-items: center;
	}

	.media {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow);
	}

	.media :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.badge {
		position: absolute;
		top: 16px;
		left: 16px;
		padding: 8px 16px;
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 700;
	}

	.lead {
		margin-top: 16px;
	}

	.timeline {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin: 56px 0 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}

	.timeline li {
		position: relative;
		padding: 24px;
		border-radius: var(--radius-lg);
	}

	.timeline li:last-child {
		background: linear-gradient(135deg, var(--navy-900), var(--navy-950));
		border-color: transparent;
		color: var(--white);
	}

	.timeline li:last-child h3,
	.timeline li:last-child .when {
		color: var(--white);
	}

	.timeline li:last-child p {
		color: rgb(255 255 255 / 0.8);
	}

	.when {
		display: inline-block;
		margin-bottom: 8px;
		font-size: 0.85rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: var(--red);
	}

	.timeline p {
		margin: 6px 0 0;
		color: var(--ink-soft);
		font-size: 0.95rem;
	}

	.needs-title {
		margin: 56px 0 16px;
	}

	.needs {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.needs li {
		padding: 20px 22px;
		border-radius: var(--radius-md);
	}

	.needs h4 {
		margin: 0 0 4px;
		font-size: 1rem;
		color: var(--navy-950);
	}

	.needs h4::before {
		content: '';
		display: block;
		width: 24px;
		height: 4px;
		margin-bottom: 12px;
		border-radius: 4px;
		background: var(--red);
	}

	.needs p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.92rem;
	}

	@media (max-width: 960px) {
		.needs {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 860px) {
		.intro,
		.timeline {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 520px) {
		.needs {
			grid-template-columns: 1fr;
		}
	}
</style>
