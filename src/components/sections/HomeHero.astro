---
import { Image } from 'astro:assets';
import { hero } from '../../data/accueil';
import { photo } from '../../lib/photos';
import { url } from '../../lib/url';
import { pad, remaining } from '../../lib/countdown';

const left = remaining(hero.countdown.target);
---

<section class="hero container" style={`--scale: ${hero.photoScale}; --position: ${hero.photoPosition}`}>
	<Image
		class="bg"
		src={photo(hero.photo)}
		alt=""
		widths={[800, 1280, 1600]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="content">
		<p class="eyebrow">{hero.eyebrow}</p>
		<h1>{hero.title}</h1>
		<p class="lead">{hero.lead}</p>
		<div class="ctas">
			<a class="btn btn-primary" href={url('/#soutenir')}>Soutenir le projet</a>
			<a class="btn btn-glass" href={url('/#rameurs')}>Découvrir les rameurs</a>
		</div>
	</div>
	<ul class="facts glass-dark">
		{
			hero.facts.map((fact) => (
				<li>
					<strong>{fact.value}</strong>
					<span class="label">{fact.label}</span>
				</li>
			))
		}
		<li class="countdown" data-countdown={hero.countdown.target}>
			<strong role="timer">
				<span data-d>{left.d}</span><small>j</small>
				<span data-h>{pad(left.h)}</span><small>h</small>
				<span data-m>{pad(left.m)}</span><small>min</small>
				<span data-s>{pad(left.s)}</span><small>s</small>
			</strong>
			<span class="label">{hero.countdown.label}</span>
			<span class="date">{hero.countdown.date}</span>
		</li>
	</ul>
</section>

<script>
	import { pad, remaining } from '../../lib/countdown';

	for (const box of document.querySelectorAll<HTMLElement>('[data-countdown]')) {
		const target = box.dataset.countdown!;
		const fields = (['d', 'h', 'm', 's'] as const).map((key) => [key, box.querySelector(`[data-${key}]`)!] as const);
		const tick = () => {
			const left = remaining(target);
			for (const [key, el] of fields) el.textContent = key === 'd' ? String(left.d) : pad(left[key]);
		};
		tick();
		setInterval(tick, 1000);
	}
</script>

<style>
	.hero {
		position: relative;
		display: grid;
		align-content: space-between;
		gap: 48px;
		min-height: min(86vh, 760px);
		margin-top: 20px;
		padding: clamp(28px, 6vw, 72px);
		overflow: hidden;
		border-radius: var(--radius-xl);
		isolation: isolate;
	}

	.hero :global(.bg) {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 45%;
	}

	@media (min-width: 900px) {
		.hero :global(.bg) {
			width: calc(var(--scale) * 100%);
			max-width: none;
			object-position: var(--position);
		}
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(100deg, rgb(10 20 56 / 0.82) 0%, rgb(10 20 56 / 0.5) 45%, rgb(10 20 56 / 0.05) 75%),
			linear-gradient(0deg, rgb(10 20 56 / 0.45), transparent 40%);
	}

	.content {
		max-width: 640px;
		align-self: center;
	}

	.eyebrow {
		color: var(--white);
	}

	h1 {
		color: var(--white);
		text-wrap: balance;
	}

	.lead {
		margin: 20px 0 32px;
		color: rgb(255 255 255 / 0.88);
	}

	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.facts {
		display: grid;
		grid-template-columns: 1fr 1fr 1.35fr;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.facts li {
		display: grid;
		gap: 2px;
		padding: 20px 24px;
	}

	.facts li + li {
		border-left: 1px solid var(--glass-dark-border);
	}

	.facts strong {
		font-size: clamp(1.4rem, 2.6vw, 1.9rem);
		font-weight: 800;
		line-height: 1.1;
	}

	.label {
		font-size: 0.88rem;
		color: rgb(255 255 255 / 0.8);
	}

	.countdown strong {
		display: flex;
		align-items: baseline;
		gap: 2px 3px;
		flex-wrap: wrap;
		font-variant-numeric: tabular-nums;
	}

	.countdown small {
		margin-right: 7px;
		font-size: 0.5em;
		font-weight: 700;
		color: rgb(255 255 255 / 0.7);
	}

	.countdown small:last-child {
		margin-right: 0;
	}

	.date {
		margin-top: 2px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.6);
	}

	@media (max-width: 720px) {
		.facts {
			grid-template-columns: 1fr;
		}

		.facts li {
			padding: 14px 20px;
		}

		.facts li + li {
			border-left: 0;
			border-top: 1px solid var(--glass-dark-border);
		}
	}
</style>
