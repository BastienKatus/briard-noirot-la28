---
import { levelLabels, type Result } from '../data/palmares';

interface Props {
	result: Result;
	compact?: boolean;
}

const { result, compact = false } = Astro.props;
const medalLabels = { gold: 'Médaille d’or', silver: 'Médaille d’argent', bronze: 'Médaille de bronze' };
---

<li class:list={['result', { compact }]}>
	<span class:list={['year', result.medal]}>
		{result.year}
		{result.medal && <span class="visually-hidden">, {medalLabels[result.medal]}</span>}
	</span>
	<div class="text">
		<p class="title">{result.result}</p>
		<p class="meta">
			{result.event} · {result.competition}, {result.location}
		</p>
	</div>
	{!compact && <span class="level">{levelLabels[result.level]}</span>}
</li>

<style>
	.result {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 14px;
		align-items: center;
		padding: 12px 0;
	}

	.result + .result {
		border-top: 1px solid rgb(16 32 90 / 0.08);
	}

	.compact {
		grid-template-columns: auto 1fr;
		padding: 8px 0;
	}

	.year {
		display: grid;
		place-items: center;
		min-width: 64px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.7);
		border: 1px solid rgb(16 32 90 / 0.12);
		color: var(--navy-900);
		font-size: 0.85rem;
		font-weight: 800;
	}

	.gold {
		background: linear-gradient(135deg, #f5d97a, var(--gold));
		border-color: transparent;
		color: #3d2e00;
	}

	.silver {
		background: linear-gradient(135deg, #e3e8ef, var(--silver));
		border-color: transparent;
		color: #1f2733;
	}

	.bronze {
		background: linear-gradient(135deg, #e8b48a, var(--bronze));
		border-color: transparent;
		color: #3b1d06;
	}

	.text p {
		margin: 0;
	}

	.title {
		font-weight: 700;
		color: var(--navy-950);
		line-height: 1.3;
	}

	.meta {
		font-size: 0.88rem;
		color: var(--ink-soft);
		line-height: 1.4;
	}

	.level {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--blue-100);
		color: var(--navy-900);
		font-size: 0.75rem;
		font-weight: 700;
	}

	@media (max-width: 520px) {
		.result {
			grid-template-columns: auto 1fr;
		}

		.level {
			display: none;
		}
	}
</style>
