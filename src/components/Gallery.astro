---
import { Image, getImage } from 'astro:assets';
import { photo } from '../lib/photos';
import type { GalleryPhoto } from '../data/albums';

interface Props {
	photos: GalleryPhoto[];
}

const items = await Promise.all(
	Astro.props.photos.map(async (item) => {
		const src = photo(item.file);
		const large = await getImage({ src, width: Math.min(1800, src.width), format: 'webp' });
		return { ...item, src, large: large.src };
	}),
);
---

<ul class="gallery">
	{
		items.map((item) => (
			<li>
				<a href={item.large} data-lightbox data-alt={item.alt} data-caption={item.caption ?? ''}>
					<Image src={item.src} alt={item.alt} widths={[400, 700]} sizes="(max-width: 640px) 50vw, (max-width: 1000px) 33vw, 380px" />
					{item.caption && <span class="caption">{item.caption}</span>}
				</a>
			</li>
		))
	}
</ul>

<style>
	.gallery {
		columns: 3 300px;
		column-gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		break-inside: avoid;
		margin-bottom: 16px;
	}

	a {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow);
	}

	a :global(img) {
		width: 100%;
		transition: transform 0.4s ease;
	}

	a:hover :global(img) {
		transform: scale(1.04);
	}

	.caption {
		position: absolute;
		inset: auto 10px 10px;
		padding: 6px 12px;
		border-radius: 999px;
		background: var(--glass-dark);
		border: 1px solid var(--glass-dark-border);
		backdrop-filter: var(--blur);
		-webkit-backdrop-filter: var(--blur);
		color: var(--white);
		font-size: 0.8rem;
		font-weight: 600;
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	a:hover .caption,
	a:focus-visible .caption {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 640px) {
		.gallery {
			columns: 2;
			column-gap: 10px;
		}

		li {
			margin-bottom: 10px;
		}
	}
</style>
