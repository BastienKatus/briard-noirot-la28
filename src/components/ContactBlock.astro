---
import { site } from '../data/site';

const topics = ['Mécénat / don d’entreprise', 'Sponsoring', 'Presse', 'Autre'];
---

<section id="contact" class="section">
	<div class="container contact glass">
		<div class="intro">
			<p class="eyebrow">Entreprises & partenaires</p>
			<h2>Embarquez avec nous jusqu’à Los Angeles</h2>
			<p class="lead">
				Votre entreprise souhaite faire un don ou devenir sponsor ? Écrivez-nous directement : nous construisons chaque
				partenariat sur mesure.
			</p>
			<ul class="perks">
				<li><strong>Mécénat</strong> : don via la Fondation du Sport Français, ouvrant droit à une réduction d’impôt.</li>
				<li><strong>Sponsoring</strong> : visibilité sur nos tenues, notre bateau et nos réseaux.</li>
				<li><strong>Rencontres</strong> : interventions et moments de partage avec vos équipes.</li>
			</ul>
		</div>

		<form class="form" action={site.contactForm.endpoint} method="post" data-contact-form data-email={site.contactEmail}>
			<input type="hidden" name="access_key" value={site.contactForm.accessKey} />
			<input type="hidden" name="subject" value="Message depuis briard-noirot-la28.fr" />
			<input type="hidden" name="from_name" value="Site briard-noirot-la28.fr" />
			<input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
			<div class="row">
				<label>
					<span>Nom</span>
					<input name="nom" autocomplete="name" required />
				</label>
				<label>
					<span>Entreprise</span>
					<input name="entreprise" autocomplete="organization" />
				</label>
			</div>
			<label>
				<span>E-mail</span>
				<input name="email" type="email" autocomplete="email" required />
			</label>
			<label>
				<span>Objet</span>
				<select name="objet">
					{topics.map((topic) => <option>{topic}</option>)}
				</select>
			</label>
			<label>
				<span>Message</span>
				<textarea name="message" rows="5" required></textarea>
			</label>
			<button class="btn btn-navy" type="submit">Envoyer le message</button>
			<p class="status" role="status" data-status hidden></p>
			<p class="hint">
				Vous pouvez aussi nous écrire directement à <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
			</p>
		</form>
	</div>
</section>

<script>
	// Sans JavaScript, le formulaire part en POST classique vers Web3Forms, qui affiche sa propre page de confirmation.
	for (const form of document.querySelectorAll<HTMLFormElement>('form[data-contact-form]')) {
		const status = form.querySelector<HTMLElement>('[data-status]')!;
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const show = (state: 'pending' | 'success' | 'error', text: string) => {
			status.hidden = false;
			status.dataset.state = state;
			status.textContent = text;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const data = Object.fromEntries(new FormData(form));
			const field = (name: string) => String(data[name] ?? '').trim();
			data.subject = `[${field('objet')}] ${field('entreprise') || field('nom')}`;
			button.disabled = true;
			show('pending', 'Envoi en cours…');
			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify(data),
				});
				if (!response.ok) throw new Error(String(response.status));
				form.reset();
				show('success', 'Merci, votre message est bien parti : nous vous répondrons rapidement.');
			} catch {
				show('error', `L’envoi a échoué. Réessayez, ou écrivez-nous directement à ${form.dataset.email}.`);
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<style>
	.contact {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(24px, 5vw, 56px);
		padding: clamp(24px, 5vw, 56px);
		border-radius: var(--radius-xl);
	}

	.perks {
		display: grid;
		gap: 10px;
		margin: 24px 0 0;
		padding: 0;
		list-style: none;
	}

	.perks li {
		padding: 12px 16px;
		border-radius: var(--radius-md);
		background: rgb(255 255 255 / 0.55);
		color: var(--ink-soft);
		font-size: 0.95rem;
	}

	.perks strong {
		color: var(--navy-950);
	}

	.form {
		display: grid;
		gap: 14px;
		align-content: start;
	}

	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
	}

	label {
		display: grid;
		gap: 6px;
	}

	label span {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--navy-900);
	}

	input,
	select,
	textarea {
		width: 100%;
		padding: 12px 16px;
		border: 1px solid rgb(16 32 90 / 0.14);
		border-radius: var(--radius-sm);
		background: rgb(255 255 255 / 0.8);
		color: var(--ink);
		font: inherit;
		font-size: 0.98rem;
	}

	textarea {
		resize: vertical;
	}

	input:focus,
	select:focus,
	textarea:focus {
		outline: none;
		border-color: var(--blue);
		box-shadow: 0 0 0 4px rgb(0 85 164 / 0.15);
	}

	.btn {
		justify-self: start;
	}

	.botcheck {
		display: none;
	}

	.status {
		margin: 0;
		padding: 12px 16px;
		border-radius: var(--radius-sm);
		background: var(--blue-100);
		color: var(--navy-900);
		font-size: 0.92rem;
		font-weight: 600;
	}

	.status[data-state='error'] {
		background: rgb(239 65 53 / 0.12);
		color: var(--red-700);
	}

	.btn:disabled {
		opacity: 0.6;
		cursor: wait;
	}

	.hint {
		margin: 0;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	@media (max-width: 860px) {
		.contact,
		.row {
			grid-template-columns: 1fr;
		}
	}
</style>
