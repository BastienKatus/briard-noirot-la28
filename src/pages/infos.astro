---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import DonationProgress from '../components/DonationProgress.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { steps, taxCards, comparison, faq } from '../data/dons';
import { Content as MentionsLegales } from '../data/textes/mentions-legales.md';

const euro = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
---

<BaseLayout title="Dons & infos" description="Comment soutenir Chloé Briard et Vincent Noirot, défiscalisation des dons, mécénat, sponsoring et mentions légales.">
	<PageHeader
		eyebrow="Dons & infos"
		title="Donner, simplement"
		lead="Tout ce qu’il faut savoir pour nous soutenir : la collecte, la réduction d’impôt, le mécénat et le sponsoring."
		image="depart-plage.jpg"
	/>

	<section id="dons" class="section">
		<div class="container split">
			<div>
				<p class="eyebrow">Comment donner</p>
				<h2>Trois étapes, un reçu fiscal</h2>
				<ol class="steps">
					{
						steps.map((step, i) => (
							<li class="glass">
								<span class="num">{i + 1}</span>
								<div>
									<h3>{step.title}</h3>
									<p>{step.text}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
			<DonationProgress />
		</div>
	</section>

	<section id="defiscalisation" class="section tinted">
		<div class="container">
			<p class="eyebrow">Défiscalisation</p>
			<h2>Un don qui coûte bien moins cher</h2>
			<p class="lead">
				La Fondation du Sport Français étant reconnue d’utilité publique, chaque don ouvre droit à une réduction d’impôt.
			</p>
			<div class="tax-grid">
				{
					taxCards.map((card) => (
						<article class="tax glass">
							<p class="audience">{card.audience}</p>
							<p class="rate">
								{card.rate} <span>{card.summary}</span>
							</p>
							<ul class="rules">
								{card.rules.map((rule) => <li>{rule}</li>)}
							</ul>
							<table>
								<thead>
									<tr>
										<th scope="col">Votre don</th>
										<th scope="col">Coût réel</th>
									</tr>
								</thead>
								<tbody>
									{card.examples.map((example) => (
										<tr>
											<td>{euro.format(example.gift)}</td>
											<td>{euro.format(example.cost)}</td>
										</tr>
									))}
								</tbody>
							</table>
							<a class="source" href={card.source} target="_blank" rel="noopener">
								Source : service-public.gouv.fr
							</a>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="mecenat-sponsoring" class="section">
		<div class="container">
			<p class="eyebrow">Entreprises</p>
			<h2>Mécénat ou sponsoring ?</h2>
			<p class="lead">Deux façons de nous accompagner, avec des règles différentes. Nous vous aidons à choisir la bonne.</p>
			<div class="table-wrap glass">
				<table class="compare">
					<thead>
						<tr>
							<td></td>
							{comparison.columns.map((column) => <th scope="col">{column}</th>)}
						</tr>
					</thead>
					<tbody>
						{
							comparison.rows.map((row) => (
								<tr>
									<th scope="row">{row.label}</th>
									{row.values.map((value) => (
										<td>{value}</td>
									))}
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section id="faq" class="section tinted">
		<div class="container narrow">
			<p class="eyebrow">Questions fréquentes</p>
			<h2>Bon à savoir</h2>
			<div class="faq">
				{
					faq.map((item) => (
						<details class="glass">
							<summary>{item.question}</summary>
							<p>{item.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<ContactBlock />

	<section id="mentions-legales" class="section">
		<div class="container narrow">
			<p class="eyebrow">Informations légales</p>
			<h2>Mentions légales</h2>
			<div class="prose glass legal">
				<MentionsLegales />
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.split {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: clamp(24px, 5vw, 56px);
		align-items: center;
	}

	.steps {
		display: grid;
		gap: 12px;
		margin: 28px 0 0;
		padding: 0;
		list-style: none;
	}

	.steps li {
		display: flex;
		gap: 16px;
		align-items: flex-start;
		padding: 18px 20px;
		border-radius: var(--radius-md);
	}

	.steps h3 {
		font-size: 1.05rem;
	}

	.steps p {
		margin: 4px 0 0;
		color: var(--ink-soft);
		font-size: 0.95rem;
	}

	.num {
		display: grid;
		flex: none;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--navy-900);
		color: var(--white);
		font-weight: 800;
	}

	.tinted {
		background: linear-gradient(180deg, transparent, rgb(0 85 164 / 0.06) 20%, rgb(0 85 164 / 0.06) 80%, transparent);
	}

	.tax-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
		margin-top: 32px;
	}

	.tax {
		display: grid;
		gap: 16px;
		align-content: start;
		padding: clamp(24px, 4vw, 36px);
		border-radius: var(--radius-xl);
	}

	.audience {
		margin: 0;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--red);
	}

	.rate {
		margin: 0;
		font-size: clamp(2.6rem, 6vw, 3.6rem);
		font-weight: 800;
		line-height: 1;
		color: var(--navy-950);
	}

	.rate span {
		display: block;
		margin-top: 6px;
		font-size: 1rem;
		font-weight: 600;
		color: var(--ink-soft);
	}

	.rules {
		margin: 0;
		padding-left: 1.1em;
		color: var(--ink-soft);
		font-size: 0.95rem;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
	}

	.tax th,
	.tax td {
		padding: 10px 14px;
		text-align: left;
	}

	.tax thead th {
		border-bottom: 1px solid rgb(16 32 90 / 0.12);
		color: var(--ink-soft);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.tax tbody tr + tr td {
		border-top: 1px solid rgb(16 32 90 / 0.06);
	}

	.tax td:last-child {
		font-weight: 800;
		color: var(--navy-900);
	}

	.source {
		font-size: 0.85rem;
	}

	.table-wrap {
		margin-top: 32px;
		overflow-x: auto;
		border-radius: var(--radius-xl);
	}

	.compare {
		min-width: 640px;
	}

	.compare th,
	.compare td {
		padding: 18px 24px;
		text-align: left;
		vertical-align: top;
	}

	.compare thead th {
		color: var(--navy-950);
		font-size: 1.05rem;
	}

	.compare tbody th {
		width: 160px;
		color: var(--ink-soft);
		font-size: 0.85rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.compare tbody tr {
		border-top: 1px solid rgb(16 32 90 / 0.08);
	}

	.narrow {
		max-width: 860px;
	}

	.faq {
		display: grid;
		gap: 12px;
		margin-top: 28px;
	}

	details {
		padding: 0 24px;
		border-radius: var(--radius-md);
	}

	summary {
		position: relative;
		padding: 20px 32px 20px 0;
		font-weight: 700;
		color: var(--navy-950);
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		content: '+';
		position: absolute;
		right: 0;
		top: 50%;
		font-size: 1.5rem;
		font-weight: 400;
		color: var(--blue);
		transform: translateY(-50%);
		transition: transform 0.2s ease;
	}

	details[open] summary::after {
		transform: translateY(-50%) rotate(45deg);
	}

	details p {
		margin: 0;
		padding-bottom: 20px;
		color: var(--ink-soft);
	}

	.legal {
		margin-top: 28px;
		padding: clamp(24px, 4vw, 40px);
		font-size: 0.98rem;
	}

	@media (max-width: 860px) {
		.split,
		.tax-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
